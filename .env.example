# 复制为 .env 并填写。.env 被 git 忽略,不会上传。

# ---- LLM API(Codex CLI 用;总控据此生成 ~/.codex/config.toml)----
# 官方 OpenAI:
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_ENV_KEY=OPENAI_API_KEY
LLM_WIRE_API=responses
LLM_MODEL=gpt-5-codex
OPENAI_API_KEY=

# OpenRouter(或任意 OpenAI 兼容网关)示例:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_ENV_KEY=OPENROUTER_API_KEY
# LLM_WIRE_API=chat
# LLM_MODEL=openai/gpt-5-codex
# OPENROUTER_API_KEY=sk-or-...

# ---- Blender MCP 端点 ----
# docker compose 内默认为 http://blender:8000/mcp;本机直连用 http://localhost:8000/mcp
MCP_URL=http://blender:8000/mcp
